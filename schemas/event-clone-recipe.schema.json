{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ck3lib/event-clone-recipe.schema.json",
  "title": "CK3 event file clone recipe (v0.5, experimental)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source_path", "source_git_blob_sha", "source_namespace", "expected_event_ids", "namespace", "source_version_label"],
  "properties": {
    "version": {"const": 1},
    "source_path": {"type": "string", "pattern": "^events/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.txt$"},
    "source_git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "expected_event_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[0-9]+$"}
    },
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$"},
    "source_version_label": {"type": "string", "minLength": 1, "maxLength": 80}
  }
}
