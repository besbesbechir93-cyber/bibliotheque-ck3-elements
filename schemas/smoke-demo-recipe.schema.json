{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ck3lib/smoke-demo-v0.9.schema.json",
  "title": "CKLib v0.9 smoke-test recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mod_name", "mod_version", "supported_version", "cooldown_days", "prestige_reward"],
  "properties": {
    "version": {"const": 1},
    "mod_name": {"type": "string", "minLength": 3, "maxLength": 65, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{2,64}$"},
    "mod_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "supported_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.\\*$"},
    "cooldown_days": {"type": "integer", "minimum": 1, "maximum": 3650},
    "prestige_reward": {"type": "integer", "minimum": 0, "maximum": 100}
  }
}
